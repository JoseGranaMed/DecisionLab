{
  "name": "decisionlab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build",
    "preview": "vite preview --host 127.0.0.1",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:smoke": "node --test tests/smoke/*.test.js",
    "test:e2e": "playwright test",
    "capture": "node scripts/capture.mjs",
    "capture:projects": "node scripts/capture-projects.mjs",
    "capture:wizard": "node scripts/capture-wizard.mjs",
    "capture:evaluation": "node scripts/capture-evaluation.mjs",
    "check": "npm run lint && npm run format:check && npm run test && npm run build"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "vite": "8.3.5",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24"
  }
}
